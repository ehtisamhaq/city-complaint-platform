# PostgreSQL Database connection (Neon / Local)
DATABASE_URL=jdbc:postgresql://localhost:5432/complaints_db
# For Neon example: jdbc:postgresql://<endpoint>.neon.tech/neondb?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT Secret (minimum 32 characters)
JWT_SECRET=YourSuperSecretKeyForJwtSigningMustBeAtLeast32CharsLong!

# Claude / Anthropic API Key (optional - will degrade gracefully to keyword classification if omitted)
ANTHROPIC_API_KEY=

# Server Port
PORT=8080
