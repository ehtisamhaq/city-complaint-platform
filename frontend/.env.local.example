# Spring Boot service that the Next.js rewrite forwards /api/* to.
# Server-side only, no /api suffix (the rewrite appends it). Not bundled to
# the browser. Required in any deployed environment.
BACKEND_URL=http://localhost:8080

# Optional: Mapbox access token from https://account.mapbox.com/
# Leave empty to fall back to free OpenStreetMap tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=
