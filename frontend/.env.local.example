# Backend API URL, including the /api context path.
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Optional: Mapbox access token from https://account.mapbox.com/
# Leave empty to fall back to free OpenStreetMap tiles.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-side only. Used by src/proxy.ts and the /api/auth/* route handler
# to reach Spring Boot directly. No /api suffix — the handler appends it.
BACKEND_URL=http://localhost:8080
